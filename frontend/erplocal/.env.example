# Copie para .env e preencha.
# Mesmo client_id precisa estar no backend em GOOGLE_CLIENT_ID (valida a audience).
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE=http://localhost:8080

# --- Google Cloud Console (mesmo projeto) ---
# Dev/navegador (botao GIS): autorize a origem JavaScript http://localhost:1420.
# App Tauri instalado (PKCE nativo): cadastre em "URIs de redirecionamento
# autorizados" EXATAMENTE estas 3 (o app usa a primeira livre):
#   http://127.0.0.1:41007/callback
#   http://127.0.0.1:41017/callback
#   http://127.0.0.1:41027/callback
# Pode ser o MESMO client_id do GIS.

# --- Backend (export antes do bootRun; NUNCA no front) ---
# export GOOGLE_CLIENT_ID=<mesmo client_id do .env>
# export GOOGLE_CLIENT_SECRET=<segredo do cliente; usado so na troca do code PKCE>
# export JWT_SECRET=<segredo aleatorio longo>
# export ERP_ADMIN_EMAIL=admin@local ERP_ADMIN_PASSWORD=<senha>
